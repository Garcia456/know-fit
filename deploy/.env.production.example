# ─────────────────────────────────────────────────────────────
# 生产环境变量样例
#
# 复制到服务器：deploy/.env.production，权限 600。
# 真实 key 只放服务器，不进仓库 / CI / 镜像。
# ⚠️ POSTGRES_PASSWORD 用字母数字（会拼进 DATABASE_URL，特殊字符要 URL 编码）。
# ─────────────────────────────────────────────────────────────

# ── 数据库（compose 内部使用）
POSTGRES_USER=knowfit
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=knowfit

# ── 镜像（CI 推送到 GHCR）
API_IMAGE=ghcr.io/garcia456/know-fit-api
WEB_IMAGE=ghcr.io/garcia456/know-fit-web
IMAGE_TAG=sha-000000000000

# ── 入口
# 无域名（临时）：http://:80
# 有域名：填域名，例如 knowfit.example.com（Caddy 自动申请 TLS）
APP_SITE_ADDR=http://:80
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# Basic Auth 的用户名 / 哈希放 deploy/.env.caddy（见同目录 .env.caddy.example）
# 🔴 bcrypt 哈希里全是 $，放这里会被 compose 的 --env-file 当成变量插值 —— 必须单独一个文件。

# 无域名 HTTP 临时模式必须设 0（否则 Secure Cookie 在 HTTP 下不回传，登录失效）
# 补上域名、走 HTTPS 后删掉这一行
COOKIE_SECURE=0

# ── 注册闸门与限流（dev-013）──────────────────────────────────
# 🔴 生产必填：不设 = 注册关闭。只发给可信测试者，不写进仓库 / 镜像。
REGISTRATION_INVITE_CODE=
# 进程内固定窗口；单实例够用，重启归零
RATE_LIMIT_LOGIN_PER_15MIN=20
RATE_LIMIT_REGISTER_PER_HOUR=5
TURN_QUOTA_PER_HOUR=120
ASSESSMENT_QUOTA_PER_HOUR=60
# 生产不要设 1（只在本地排查时临时关）
RATE_LIMIT_DISABLED=
# 生产在 Caddy 后面，读 X-Forwarded-For；显式写出免得依赖默认值
TRUST_PROXY=1

# ── 运维（tools profile）──────────────────────────────────────
# demo 账号：docker compose --profile tools run --rm demo-seed
#   凭据在 deploy/demo-accounts/.demo-accounts.json（gitignore，0600）
# 检索体检：docker compose --profile tools run --rm rag-doctor

# ── LLM / embedding / rerank（真实 provider）
LLM_PROVIDER=openai
LLM_ENABLE_THINKING=off
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen-plus
OPENAI_EMBEDDING_MODEL=text-embedding-v4

EMBEDDING_PROVIDER=real
RERANK_PROVIDER=real
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=

# 运行期不用采集 / ASR；保持 fake，防止误触发
KB_PROVIDER=fake
ASR_PROVIDER=fake

# ── 运行
PORT=3000
LOG_LEVEL=info