# 依赖
node_modules/
.pnpm-store/

# 环境变量与密钥（LLM API key 等，绝不能进仓库）
.env
.env.*
!.env.example

# 构建产物
dist/
build/
.next/
*.tsbuildinfo

# Python 字节码（apps/api/tools/asr_transcribe.py 跑一次就生成）
__pycache__/
*.pyc

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时文件
*.tmp
.cache/

# 浏览器核对工作件（playwright-cli 的快照 / 截图，只在本机）
.playwright-cli/

# 本机 worktree（每个都是完整仓库副本，不进主仓库）
.claude/worktrees/

# 本地工作件（作者 2026-10-08 决定）—— 只在本机存在，不进仓库
# progress.md / session-handoff.md 是会话日志，init.sh 是本地环境检查；
# 三者都不属于作品集的交付物，故不随仓库分发（本地文件保留）
progress.md
progress-archive.md
session-handoff.md
session-handoff-archive.md
init.sh
