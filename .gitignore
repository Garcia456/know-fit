# 依赖
node_modules/
.pnpm-store/

# 环境变量与密钥（LLM API key 等，绝不能进仓库）
.env
.env.*
!.env.example
!**/.env.*.example
deploy/.env.production
.deployed-tag
backups/

# demo 账号的真实密码（seed 脚本生成，只在本机 / 服务器）
.demo-accounts.json
deploy/demo-accounts/

# 构建产物
dist/
build/
.next/
*.tsbuildinfo

# Python 字节码（apps/api/tools/asr_transcribe.py 跑一次就生成）
__pycache__/
*.pyc

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时文件
*.tmp
.cache/

# 本机部署验证用的临时件
tmp-test/

# 浏览器核对工作件（playwright-cli 的快照 / 截图，只在本机）
.playwright-cli/

# 苹方是苹果专有字体，只留在本机；线上用同目录的思源黑体（OFL，随仓库分发）
apps/web/public/fonts/PingFangSC-*.woff2

# 本机 worktree（每个都是完整仓库副本，不进主仓库）
.claude/worktrees/

# progress.md / session-handoff.md 是会话日志，init.sh 是本地环境检查；
progress.md
session-handoff.md
init.sh
