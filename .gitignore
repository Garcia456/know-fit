# 依赖
node_modules/
.pnpm-store/

# 环境变量与密钥（LLM API key 等，绝不能进仓库）
.env
.env.*
!.env.example
!**/.env.*.example
deploy/.env.production
.deployed-tag
backups/

# demo 账号的真实密码
.demo-accounts.json
deploy/demo-accounts/

# 构建产物
dist/
build/
.next/
*.tsbuildinfo

# Python 字节码（apps/api/tools/asr_transcribe.py 跑一次就生成）
__pycache__/
*.pyc

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时文件
*.tmp
.cache/

# 部署验证用的临时件
tmp-test/
# kb:sync 导出中间件（含知识库转写原文，绝不入库）
tmp/

# 浏览器核对工作件（playwright-cli 的快照 / 截图，只在本机）
.playwright-cli/

# worktree
.claude/worktrees/

# progress.md / session-handoff.md 是会话日志，init.sh 是本地环境检查；
progress.md
session-handoff.md
feature_list.json
init.sh

# 文档
/docs