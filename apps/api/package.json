{
  "name": "@know-fit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "llm:smoke": "node --env-file-if-exists=../../.env --import tsx src/llm/smoke.ts",
    "kb:ingest": "node --env-file-if-exists=../../.env --import tsx src/kb/ingest.ts",
    "kb:index": "node --env-file-if-exists=../../.env --import tsx src/kb/index.ts",
    "kb:smoke": "node --env-file-if-exists=../../.env --import tsx src/kb/smoke.ts",
    "kb:eval:export": "node --env-file-if-exists=../../.env evals/claim-type/export.mjs",
    "kb:eval:check": "node evals/claim-type/check-dataset.mjs",
    "kb:eval": "node --env-file-if-exists=../../.env evals/claim-type/run-eval.mjs",
    "rag:check": "node --env-file-if-exists=../../.env --import tsx src/rag/check.ts",
    "rag:smoke": "node --env-file-if-exists=../../.env --import tsx src/rag/smoke.ts",
    "rag:eval:queries": "node --env-file-if-exists=../../.env --import tsx evals/rag/generate-queries.ts",
    "rag:eval": "node --env-file-if-exists=../../.env --import tsx evals/rag/eval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@langchain/openai": "1.6.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "promptfoo": "0.124.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}