    "body": { "size": 14, "weights": [400, 500, 600], "usage": "气泡、卡片标题、设置项" },
    "body-lg": { "size": 14.5, "weights": [400], "usage": "Agent 文本、输入占位符" },
    "nav": { "size": 15, "weights": [400, 600], "usage": "顶部导航文字入口、数据钩子主张" },
    "title-sm": { "size": 17, "weights": [600], "usage": "档案姓名" },
    "title": { "size": 18, "weights": [600], "usage": "抽屉标题" },
    "display": { "size": 26, "weights": [600], "usage": "数据页大数字" }
  },
  "effect": {
    "shadow-200": { "figma": "Drop Shadow/200", "origin": "figma", "layers": [{ "x": 0, "y": 1, "blur": 4, "color": "#0C0C0D", "opacity": 0.05 }, { "x": 0, "y": 1, "blur": 4, "color": "#0C0C0D", "opacity": 0.1 }], "usage": "卡片、抽屉；原型整体保持扁平，只在需要脱离页面时才用" },
    "shadow-float": { "origin": "local", "value": "0 1px 2px rgba(0,0,0,.06), 0 12px 32px rgba(0,0,0,.08)", "usage": "仅画板上的手机外框" }
  },
  "components": [
    { "figma": "状态栏 / Status bar", "figmaType": "COMPONENT", "local": ".statusbar", "note": "自绘矢量图标（信号/Wi-Fi/电池）；iOS 官方 kit 因席位无权限 import，未采用" },
    { "figma": "顶部导航 / Top nav", "figmaType": "COMPONENT_SET", "variants": ["Active=会话", "Active=历史", "Active=我的"], "local": ".topnav / .tabs / .tab", "note": "左「对话历史」+ 三文字入口 + 右「创建新会话」" },
    { "figma": "气泡 / 用户消息", "figmaType": "COMPONENT", "local": ".msg-user", "note": "右下角收成 4px，朝向输入栏" },
    { "figma": "快捷提问 / Quick chip", "figmaType": "COMPONENT", "local": ".chip" },
    { "figma": "输入栏 / Composer", "figmaType": "COMPONENT", "local": ".composer", "note": "胶囊输入 + 近黑圆形发送键" },
    { "figma": "列表行 / 会话", "figmaType": "COMPONENT", "local": ".conv（抽屉）/ .row（卡片内列表）" },
    { "figma": "设置项 / 档案", "figmaType": "COMPONENT", "local": ".set-row" },
    { "figma": "来源引用 / Citation", "figmaType": "COMPONENT_SET", "variants": ["有源=是", "有源=否"], "local": ".src / .nosrc", "note": "F5 硬约束：两类必须可区分（ADR-005）" },
    { "figma": "Button（库）", "figmaType": "COMPONENT_SET", "variants": ["Variant=Primary|Subtle, Size=Small"], "local": ".btn / .btn--ghost", "origin": "figma-library" },
    { "figma": "Icon Button（库）", "figmaType": "COMPONENT_SET", "variants": ["Variant=Neutral, Size=Medium"], "local": ".icon-btn", "origin": "figma-library" },
    { "figma": "Switch Field（库）", "figmaType": "COMPONENT_SET", "variants": ["State=Default, Value Type=Checked"], "local": ".switch", "origin": "figma-library" },
    { "figma": "Avatar（库）", "figmaType": "COMPONENT_SET", "variants": ["Type=Initial, Size=Medium, Shape=Circle"], "local": ".avatar", "origin": "figma-library" },
    { "figma": null, "local": ".card（记录确认卡）", "note": "本地组合，未进 Figma（单屏一次性使用）" },
    { "figma": null, "local": ".hook（数据钩子）", "note": "本地组合；§6.3 硬约束：必须带已算好的判定" },
    { "figma": null, "local": ".verdict / .advice（评估卡）", "note": "本地组合；判定 + 建议 + 来源三段" }
  ]
