  "typeSteps": {
    "_origin": "local — 库的字阶只有 14 / 16 / 24，对 390 宽的移动端太粗（元信息只能落 14 就过大），因此在中间补档",
    "micro": { "size": 11, "weights": [500, 600], "usage": "标签、时间戳、图表轴" },
    "caption": { "size": 12, "weights": [400, 500, 600], "usage": "元信息、分组标题" },
    "meta": { "size": 12.5, "weights": [400, 500, 600], "usage": "来源卡的博主名与标题、卡片脚注" },
    "label": { "size": 13, "weights": [400, 500, 600], "usage": "动作名、列表说明、按钮文字" },
