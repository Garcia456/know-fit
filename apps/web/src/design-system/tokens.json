    "line": { "cssVar": "--line", "value": "#E6E6E6", "origin": "local", "usage": "卡片内分隔线、输入栏上边线", "note": "比 Border/Default/Default 更浅，用在密集列表里减少噪点" },
    "line-2": { "cssVar": "--line-2", "value": "#D9D9D9", "figma": "Border/Default/Default", "origin": "figma", "usage": "卡片外框、未被选中的胶囊描边、图表底柱" },
    "brand": { "cssVar": "--brand", "value": "#2C2C2C", "figma": "Background/Brand/Default", "origin": "figma", "usage": "主按钮、选中胶囊、图表当前值、头像底" },
    "chart-green": { "cssVar": "--chart-green", "value": "#14AE5C", "figma": "Background/Positive/Default", "origin": "figma", "usage": "仅作为图形标记（上升柱、达标标记），不做文字" },
    "green-text": { "cssVar": "--green-text", "value": "#0B7A45", "origin": "local", "usage": "正文里的「上升 / 达标」文字", "note": "库里的 #14AE5C 对白底只有 2.5:1，当文字不过 AA" }
