{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // web 由 Vite 打包，用 bundler resolution
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}