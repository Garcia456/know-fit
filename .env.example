# ─── 环境变量样例 ────────────────────────────────────────────────────
# 复制为 .env 后使用（.env 已在 .gitignore 里，绝不要提交真实密钥）。
#
# 🔴 约定（作者 2026-10-11 明令）：
#   ① 键名**不带项目 / 业务 / 服务名** —— 一律用通用名（OpenAI 风格）。
#   ② 三样外部凭据（base url / api key / 模型名）**值一律留空**，由你自行填充；
#      仓库与 CI 里永不出现真实值。
#   ③ 非敏感开关保留安全缺省，便于「克隆即跑」。

# 本地数据库（由 docker-compose.yml 起的 pgvector 容器）。非敏感，保留默认值。
DATABASE_URL=postgres://knowfit:knowfit@localhost:5432/knowfit

# ── 模型服务（OpenAI 兼容协议）── 见 ADR-011 / MVP与技术方案 §3.2 ──
# 这三个变量 dev-002 起才被读取（dev-001 不读）。
# 📌 用标准名的一个实际好处：ChatOpenAI 与 OpenAI SDK **默认就读 OPENAI_API_KEY / OPENAI_BASE_URL**，
#    因此真实实现里可以不显式传参（见 apps/api/src/llm/）。

# 兼容端点根地址。示例（阿里云百炼，OpenAI 兼容模式）：
#    OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# API key。⚠️ 只写进你本机 .env，绝不进仓库 / CI。
OPENAI_API_KEY=

# 模型名。本项目 MVP 统一档（ADR-011 补注 / MVP与技术方案 §3.2）：
#    OPENAI_MODEL=deepseek-v4.1-flash
OPENAI_MODEL=

# 客户端开关：'fake'（确定性替身，CI / 单测用）| 'openai'（真实调用，本地 smoke 用）。
# 缺省 = 'fake'。CI 里永远是 fake，且 CI 里没有任何 key。
LLM_PROVIDER=fake