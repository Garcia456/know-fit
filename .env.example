# ─── know-fit 环境变量样例 ───────────────────────────────────────────
# 复制为 .env 后使用（.env 已在 .gitignore 里，绝不要提交真实密钥）。
#
# 🔴 约定（作者 2026-10-11 明令）：**三样外部凭据 —— url / 模型名 / api key ——
#    一律留空**，由你自行填充；仓库与 CI 里永不出现真实值。
#    其余**非敏感开关**（如数据库连接串、LLM 客户端选择）保留安全缺省，便于「克隆即跑」。
#    每个键上方的注释给出用途与推荐取值。

# 本地数据库（由 docker-compose.yml 起的 pgvector 容器）
# 非敏感，可保留此默认值（与 docker-compose.yml / apps/api/src/db/client.ts 一致）。
DATABASE_URL=postgres://knowfit:knowfit@localhost:5432/knowfit

# ── 千问云 / 百炼（OpenAI 兼容协议）—— 见 ADR-011 / 技术方案 §3.2 ──
# dev-002 起开始真实读取这三个变量（dev-001 不读）。

# 1) 兼容端点根地址。官方示例（阿里云百炼，OpenAI 兼容模式）：
#    DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# 2) 百炼 API key。⚠️ 只写进你本机 .env，绝不进仓库 / CI。
DASHSCOPE_API_KEY=

# 3) 模型名。本项目 MVP 统一档（feat-006 §3.2 / ADR-011 补注）：
#    DASHSCOPE_MODEL=deepseek-v4.1-flash
DASHSCOPE_MODEL=

# 4) LLM 客户端开关：'fake'（确定性替身，CI / 单测用）| 'dashscope'（真实调用，本地 smoke 用）。
#    缺省 = 'fake'。CI 里永远是 fake，且 CI 里没有任何 key。
KNOWFIT_LLM=fake