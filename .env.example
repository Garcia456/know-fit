# 环境变量样例 → 复制为 .env 使用（.env 已 gitignore，勿提交真实密钥）

# 本地 Postgres（docker compose 起）
DATABASE_URL=postgres://knowfit:knowfit@localhost:5432/knowfit

# OpenAI 兼容端点；三项都留空，自行填。CI 与仓库里无真实值。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# fake = 替身（CI）｜openai = 真实调用（本地）
LLM_PROVIDER=fake
# 思考模式：off = 关（默认，单次 2–5s）｜on = 开（单次 30–100s）
LLM_ENABLE_THINKING=off

# ── 知识库采集（dev-004）────────────────────────────────────
# fake = 替身（CI，不联网）｜real = 走自建解析服务 + 本机 ASR
KB_PROVIDER=fake
# 自建抖音解析服务基址（含签名解析的第三方实现，仅作者本机）
KB_PARSER_BASE_URL=http://127.0.0.1:8000
# 解析服务的 API key（v5 走 X-API-Key 头；真实值只放 .env，别进仓库 / CI）
KB_PARSER_API_KEY=
# fake = 替身（CI，不加载模型）｜local = 本机 faster-whisper
ASR_PROVIDER=fake
# 本机 ASR 三件套：python 解释器 / 脚本路径（留空用仓库内默认）/ 模型与语言
# ASR_PYTHON 要指向装了 faster-whisper 的那个解释器（例：<conda>/envs/asr/python.exe）
ASR_PYTHON=
ASR_SCRIPT=
# 已定的模型是 large-v3 —— 换它会同时换掉纠错表的适用面（表是在它上面测的）
ASR_MODEL=large-v3
ASR_LANGUAGE=zh
# 跑在哪：cpu（默认，不折腾显卡）｜cuda —— 有 NVIDIA 卡就填 cuda，实测快一个量级
ASR_DEVICE=cpu
# 留空按设备自动选（cpu→int8，cuda→float16）；int8 在 GPU 上反而慢，别手动填反
ASR_COMPUTE_TYPE=
# 只跑钉住的**前 N 条**、不走遍历 —— 快速验「管道通 + 是口播」，留空 = 全量
KB_SMOKE_LIMIT=
# 可选：设成某条 platform_video_key，采完就把它下架（验下架通道）
KB_RETIRE=

# ── 知识库切片与索引（dev-004b）──────────────────────────────
# fake = 替身（1024 维确定性向量，CI 不联网）｜real = 走真实 embedding 端点
EMBEDDING_PROVIDER=fake
# 真实向量模型；换它会换掉向量空间，必须整库重建（embedding_model 记了版本串）
OPENAI_EMBEDDING_MODEL=text-embedding-v4
# 可选：只索引前 N 条 / 指定一条源（先 1 条真跑用）
KB_INDEX_LIMIT=
KB_INDEX_KEY=
# 可选：闸① 并发数（默认 4）
KB_INDEX_CONCURRENCY=
# 1 = 把样本正文与前缀打到终端（只在本机复核切片时开）
KB_INDEX_SHOW_TEXT=

# ── RAG 检索与引用（dev-005）────────────────────────────────
# fake = 替身（词面重叠排序，CI 不联网）｜real = qwen3-rerank
RERANK_PROVIDER=fake
# 🔴 gte-rerank-v2 已下线，别换回去
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 留空则复用 OPENAI_API_KEY（同一个百炼账号）
RERANK_API_KEY=
# 召回 / 重排 / 门槛 / 引用条数 —— 0.5 是推断初值，靠 pilot 反调
RAG_TOP_K=50
RAG_TOP_N=5
RAG_MIN_SIMILARITY=0.5
RAG_MAX_CITATIONS=2